{
  "name": "website-to-md",
  "version": "1.0.0",
  "description": "Convert a public web page into editable Markdown with a small web app or CLI.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "install:browser": "npx playwright install chromium",
    "test": "node --test test/*.test.js",
    "lint": "eslint src public/app.js public/preview.js test scripts",
    "format": "prettier --write 'src/**/*.js' 'public/*.{js,css,html}' 'test/**/*.js' 'scripts/**/*.js' eslint.config.js",
    "format:check": "prettier --check 'src/**/*.js' 'public/*.{js,css,html}' 'test/**/*.js' 'scripts/**/*.js' eslint.config.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16",
    "express": "^4.22.3",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^26.1.0",
    "marked": "^16.4.2",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "license": "MIT",
  "bin": {
    "web-to-md": "./src/cli.js"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  }
}
