{
  "name": "website-to-md",
  "version": "1.0.0",
  "description": "Convert a public web page into editable Markdown with a small web app or CLI.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "install:browser": "npx playwright install chromium",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/lint.js",
    "format": "node scripts/format.js",
    "format:check": "node scripts/format.js --check",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "express": "^4.18.2",
    "jsdom": "^24.0.0",
    "playwright": "^1.44.0",
    "turndown": "^7.1.3",
    "turndown-plugin-gfm": "^1.0.2",
    "ipaddr.js": "^1.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "bin": {
    "web-to-md": "./src/cli.js"
  }
}
